{
 "doctype": "DocType",
 "name": "Hub Chat Group",
 "module": "Telegram Connector",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "group_name",
   "fieldtype": "Data",
   "label": "Group Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "channel",
   "fieldtype": "Select",
   "label": "Channel",
   "options": "Telegram\nWhatsApp",
   "default": "WhatsApp",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "chat_id",
   "fieldtype": "Data",
   "label": "Group Chat ID",
   "reqd": 1,
   "in_list_view": 1,
   "description": "WhatsApp: the group id ending with @g.us (e.g. 120363012345678901@g.us). Use WhatsApp Diagnostics in Notification Hub to list your groups. Telegram: the group chat id, a negative number (e.g. -1001234567890); the bot must be a member of the group."
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  }
 ],
 "autoname": "field:group_name",
 "title_field": "group_name",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC"
}
