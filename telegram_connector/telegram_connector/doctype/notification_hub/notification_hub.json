{
 "doctype": "DocType",
 "name": "Notification Hub",
 "module": "Telegram Connector",
 "engine": "InnoDB",
 "sort_field": "creation",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "sec_guides",
   "fieldtype": "Section Break",
   "label": "Setup Guides (click for step-by-step instructions)"
  },
  {
   "fieldname": "btn_guide_whatsapp",
   "fieldtype": "Button",
   "label": "WhatsApp Guide"
  },
  {
   "fieldname": "col_g1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "btn_guide_tg_bot",
   "fieldtype": "Button",
   "label": "Telegram Bot Guide"
  },
  {
   "fieldname": "col_g2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "btn_guide_tg_user",
   "fieldtype": "Button",
   "label": "Telegram User Account Guide"
  },
  {
   "fieldname": "col_g3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "btn_guide_trouble",
   "fieldtype": "Button",
   "label": "Troubleshooting"
  },
  {
   "fieldname": "sec_main",
   "fieldtype": "Section Break",
   "label": "General"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enable Telegram"
  },
  {
   "fieldname": "whatsapp_enabled",
   "fieldtype": "Check",
   "label": "Enable WhatsApp"
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Mode",
   "options": "Bot\nUser Account",
   "default": "Bot",
   "reqd": 1
  },
  {
   "fieldname": "default_country_code",
   "fieldtype": "Data",
   "label": "Default Country Code",
   "default": "20"
  },
  {
   "fieldname": "group_chat_id",
   "fieldtype": "Data",
   "label": "Group Chat ID",
   "description": "Telegram group chat id (negative number, e.g. -100...). Transportation Request \"Documents requested\" messages are posted here, by the bot (Bot mode) or by the logged-in account (User Account mode, which must be a member of the group).",
   "default": "-5524050749"
  },
  {
   "fieldname": "sec_bot",
   "fieldtype": "Section Break",
   "label": "Bot",
   "depends_on": "eval:doc.mode=='Bot'"
  },
  {
   "fieldname": "bot_token",
   "fieldtype": "Password",
   "label": "Bot Token"
  },
  {
   "fieldname": "bot_username",
   "fieldtype": "Data",
   "label": "Bot Username",
   "read_only": 1
  },
  {
   "fieldname": "link_method",
   "fieldtype": "Select",
   "label": "Link Method",
   "options": "Polling\nWebhook",
   "default": "Polling"
  },
  {
   "fieldname": "btn_test_connection",
   "fieldtype": "Button",
   "label": "Test Connection"
  },
  {
   "fieldname": "btn_set_webhook",
   "fieldtype": "Button",
   "label": "Set Webhook",
   "depends_on": "eval:doc.link_method=='Webhook'"
  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "hidden": 1
  },
  {
   "fieldname": "last_update_id",
   "fieldtype": "Int",
   "label": "Last Update Id",
   "hidden": 1
  },
  {
   "fieldname": "sec_acc",
   "fieldtype": "Section Break",
   "label": "User Account",
   "depends_on": "eval:doc.mode=='User Account'"
  },
  {
   "fieldname": "api_id",
   "fieldtype": "Data",
   "label": "Api Id"
  },
  {
   "fieldname": "api_hash",
   "fieldtype": "Password",
   "label": "Api Hash"
  },
  {
   "fieldname": "login_phone",
   "fieldtype": "Data",
   "label": "Login Phone"
  },
  {
   "fieldname": "btn_send_code",
   "fieldtype": "Button",
   "label": "Send Code"
  },
  {
   "fieldname": "login_code",
   "fieldtype": "Data",
   "label": "Login Code"
  },
  {
   "fieldname": "two_fa_password",
   "fieldtype": "Password",
   "label": "Two Fa Password"
  },
  {
   "fieldname": "btn_verify",
   "fieldtype": "Button",
   "label": "Verify & Login"
  },
  {
   "fieldname": "account_status",
   "fieldtype": "Data",
   "label": "Account Status",
   "read_only": 1
  },
  {
   "fieldname": "session_string",
   "fieldtype": "Password",
   "label": "Session String",
   "read_only": 1
  },
  {
   "fieldname": "sec_wa",
   "fieldtype": "Section Break",
   "label": "WhatsApp (Wapilot)",
   "depends_on": "eval:doc.whatsapp_enabled"
  },
  {
   "fieldname": "wapilot_token",
   "fieldtype": "Password",
   "label": "Wapilot API Token"
  },
  {
   "fieldname": "wapilot_base_url",
   "fieldtype": "Data",
   "label": "Wapilot Base URL",
   "default": "https://app.wapilot.io"
  },
  {
   "fieldname": "wapilot_phone_format",
   "fieldtype": "Select",
   "label": "Phone Format (API v2)",
   "options": "Digits only (2012...)\nWith plus (+2012...)",
   "default": "Digits only (2012...)"
  },
  {
   "fieldname": "btn_wa_check",
   "fieldtype": "Button",
   "label": "WhatsApp Diagnostics"
  },
  {
   "fieldname": "sec_wa_adv",
   "fieldtype": "Section Break",
   "label": "Advanced (API v2 payloads)",
   "collapsible": 1,
   "depends_on": "eval:doc.whatsapp_enabled"
  },
  {
   "fieldname": "wapilot_payload",
   "fieldtype": "Small Text",
   "label": "Text Message Payload (JSON)"
  },
  {
   "fieldname": "wapilot_media_endpoint",
   "fieldtype": "Data",
   "label": "Media Endpoint (API v2)"
  },
  {
   "fieldname": "wapilot_media_payload",
   "fieldtype": "Small Text",
   "label": "Media Payload (JSON)"
  },
  {
   "fieldname": "sec_test",
   "fieldtype": "Section Break",
   "label": "Test"
  },
  {
   "fieldname": "test_channel",
   "fieldtype": "Select",
   "label": "Test Channel",
   "options": "Telegram\nWhatsApp",
   "default": "Telegram"
  },
  {
   "fieldname": "test_recipient",
   "fieldtype": "Data",
   "label": "Test Recipient"
  },
  {
   "fieldname": "test_text",
   "fieldtype": "Data",
   "label": "Test Text",
   "default": "Test message from ERPNext"
  },
  {
   "fieldname": "btn_send_test",
   "fieldtype": "Button",
   "label": "Send Test Message"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "issingle": 1
}
