   "fieldname": "sec_tg",
   "fieldtype": "Section Break",
   "label": "Telegram"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enable Telegram"
  },
  {
   "fieldname": "col_tg",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Mode",
   "options": "Bot\nUser Account",
   "default": "Bot",
   "reqd": 1,
   "depends_on": "enabled"
  },
  {
   "fieldname": "sec_bot",
   "fieldtype": "Section Break",
   "label": "Bot",
   "depends_on": "eval:doc.enabled && doc.mode=='Bot'"
  },
  {
   "fieldname": "bot_token",
   "fieldtype": "Password",
   "label": "Bot Token"
  },
  {
   "fieldname": "bot_username",
   "fieldtype": "Data",
   "label": "Bot Username",
   "read_only": 1
  },
  {
   "fieldname": "link_method",
   "fieldtype": "Select",
   "label": "Link Method",
   "options": "Polling\nWebhook",
   "default": "Polling"
  },
  {
   "fieldname": "col_bot",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "group_chat_id",
