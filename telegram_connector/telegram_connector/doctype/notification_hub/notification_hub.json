  },
  {
   "fieldname": "test_channel",
   "fieldtype": "Select",
   "label": "Test Channel",
   "options": "Telegram\nWhatsApp",
   "default": "Telegram"
  },
  {
   "fieldname": "test_recipient",
   "fieldtype": "Data",
   "label": "Test Recipient",
   "description": "Mobile number, a Telegram chat id, or a WhatsApp group id ending with @g.us"
  },
  {
   "fieldname": "col_test",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "test_text",
   "fieldtype": "Data",
   "label": "Test Text",
   "default": "Test message from ERPNext"
