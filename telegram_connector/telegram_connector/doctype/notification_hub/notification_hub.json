   "fieldtype": "Tab Break",
   "label": "Templates"
  },
  {
   "fieldname": "sec_templates",
   "fieldtype": "Section Break",
   "description": "Reusable messages. Pick one in a notification or user alert; editing it here updates everyone who uses it."
  },
  {
   "fieldname": "templates",
   "fieldtype": "Table",
   "label": "Templates",
   "options": "Hub Message Template"
  },
  {
   "fieldname": "tab_groups",
   "fieldtype": "Tab Break",
   "label": "Groups"
  },
  {
   "fieldname": "sec_groups",
   "fieldtype": "Section Break",
   "description": "WhatsApp and Telegram groups that notifications can be sent to."
  },
  {
   "fieldname": "groups",
   "fieldtype": "Table",
   "label": "Groups",
   "options": "Hub Group"
  },
  {
   "fieldname": "tab_telegram",
   "fieldtype": "Tab Break",
   "label": "Telegram"
  },
