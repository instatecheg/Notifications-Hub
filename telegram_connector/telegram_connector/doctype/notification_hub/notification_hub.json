   "fieldtype": "Section Break",
   "label": "User Account",
   "depends_on": "eval:doc.enabled && doc.mode=='User Account'"
  },
  {
   "fieldname": "api_id",
   "fieldtype": "Data",
   "label": "Api Id"
  },
  {
   "fieldname": "api_hash",
   "fieldtype": "Password",
   "label": "Api Hash"
  },
  {
   "fieldname": "login_phone",
   "fieldtype": "Data",
   "label": "Login Phone"
  },
  {
   "fieldname": "btn_send_code",
   "fieldtype": "Button",
   "label": "Send Code"
  },
  {
   "fieldname": "col_acc",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "login_code",
   "fieldtype": "Data",
   "label": "Login Code"
  },
  {
   "fieldname": "two_fa_password",
   "fieldtype": "Password",
   "label": "Two Fa Password"
  },
  {
   "fieldname": "btn_verify",
   "fieldtype": "Button",
   "label": "Verify & Login"
  },
  {
   "fieldname": "account_status",
   "fieldtype": "Data",
   "label": "Account Status",
   "read_only": 1
  },
  {
   "fieldname": "session_string",
   "fieldtype": "Password",
   "label": "Session String",
   "read_only": 1
  },
  {
